# PostgreSQL (apply migrations/001_init.sql once before first run)
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=contgen_app
DB_PASSWORD=change_me
DB_NAME=contgen_db

# HTTP / local development
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
APP_URL=http://localhost:8080
# Set TUNNEL_PROVIDER=tailscale when the Tailscale Funnel URL is enabled;
# leave ngrok for the default reserved-domain development flow.
TUNNEL_PROVIDER=ngrok
# Production must keep this false. For a local browser-only run, override with
# DEV_LOGIN=true and use a loopback APP_URL/SERVER_HOST.
DEV_LOGIN=false
WORKER_ENABLED=true
# Duration of generated vertical videos in seconds (3-60, default 12).
RENDER_SECONDS=12
ADS_ENABLED=false
# Numeric Reward block ID from https://partner.adsgram.ai. Required when
# ADS_ENABLED=true; leave empty while using Stars only.
ADSGRAM_BLOCK_ID=
# Only for an AdsGram Test Platform. Keep false in production.
ADSGRAM_DEBUG=false
DATA_DIR=data

# Telegram Mini App and Stars payments
# DEV_LOGIN=false when running inside Telegram.
TELEGRAM_BOT_TOKEN=
SESSION_SECRET=replace_with_at_least_32_random_bytes
ADMIN_TELEGRAM_IDS=
